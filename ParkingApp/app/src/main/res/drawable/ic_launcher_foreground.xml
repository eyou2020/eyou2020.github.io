<?xml version="1.0" encoding="utf-8"?>
<!--
  108×108dp 캔버스. 어댑티브 아이콘 안전영역 = 중앙 72×72dp (18dp 여백).
  "P" 글자는 안전영역 안쪽(x:26~82, y:18~90)에 배치.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!--
      굵은 "P" 구성:
        세로 기둥: x=26~46, y=18~90  (너비 20, 높이 72)
        가로 상단 캡: x=26~74, y=18~40  (너비 48, 높이 22)
        오른쪽 둥근 볼: 중심(74,40), 반지름=22 → 아래쪽 반원 y=40~62
        가로 하단 캡: x=26~74, y=40~62
        → P 볼 내부 공백(컷아웃): x=46~74, y=30~50, 반원으로 처리
    -->

    <!-- P 글자 전체 (흰색) — filled path -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="
          M26,18
          L26,90
          L46,90
          L46,62
          L66,62
          Q88,62 88,40
          Q88,18 66,18
          Z
          M46,38
          L46,46
          L64,46
          Q68,46 68,40
          Q68,34 64,34
          L46,34
          Z
        " />
</vector>
