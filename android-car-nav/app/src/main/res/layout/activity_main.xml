<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/bg_main">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- 헤더 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="차량 네비 에뮬레이터"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:gravity="center"
            android:paddingTop="24dp"
            android:paddingBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="블루투스 연결 시 자동 주행 모드 활성화"
            android:textSize="13sp"
            android:textColor="@color/text_secondary"
            android:gravity="center"
            android:paddingBottom="24dp" />

        <!-- 서비스 상태 카드 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_bg"
            android:padding="16dp"
            android:layout_marginBottom="14dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="서비스 상태"
                android:textSize="12sp"
                android:textColor="@color/text_secondary"
                android:paddingBottom="6dp" />

            <TextView
                android:id="@+id/tv_service_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="○ 중지됨"
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="@color/status_disconnected" />
        </LinearLayout>

        <!-- 기기 선택 카드 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_bg"
            android:padding="16dp"
            android:layout_marginBottom="14dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="차량 블루투스 기기"
                android:textSize="12sp"
                android:textColor="@color/text_secondary"
                android:paddingBottom="6dp" />

            <TextView
                android:id="@+id/tv_selected_device"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="선택된 기기 없음"
                android:textSize="15sp"
                android:textColor="@color/text_primary"
                android:paddingBottom="12dp" />

            <Button
                android:id="@+id/btn_select_device"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="블루투스 기기 선택"
                android:textColor="@color/white"
                android:backgroundTint="@color/accent_blue" />
        </LinearLayout>

        <!-- 서비스 시작/중지 버튼 -->
        <Button
            android:id="@+id/btn_toggle_service"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="서비스 시작"
            android:textSize="17sp"
            android:textColor="@color/white"
            android:backgroundTint="@color/accent_green"
            android:layout_marginBottom="20dp" />

        <!-- 사용 방법 카드 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_bg"
            android:padding="16dp"
            android:layout_marginBottom="24dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="사용 방법"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/text_secondary"
                android:paddingBottom="8dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="1. 차량 블루투스와 이 휴대폰을 먼저 페어링하세요\n2. 위에서 차량 블루투스 기기를 선택하세요\n3. [서비스 시작]을 누르세요\n4. 차량에 타면 블루투스가 자동 연결되고\n    주행 모드가 활성화됩니다\n5. 부팅 후에도 자동으로 재시작됩니다"
                android:textSize="13sp"
                android:textColor="@color/text_secondary"
                android:lineSpacingMultiplier="1.6" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
