<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/bg_main">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- 헤더 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="차량 네비 HFP 서버"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:gravity="center"
            android:paddingTop="24dp"
            android:paddingBottom="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="다른 폰이 이 기기를 차량 핸즈프리로 인식합니다"
            android:textSize="13sp"
            android:textColor="@color/text_secondary"
            android:gravity="center"
            android:paddingBottom="20dp" />

        <!-- 서비스 상태 카드 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_bg"
            android:padding="16dp"
            android:layout_marginBottom="14dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="HFP 서버 상태"
                android:textSize="12sp"
                android:textColor="@color/text_secondary"
                android:paddingBottom="6dp" />

            <TextView
                android:id="@+id/tv_service_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="○ 서버 중지됨"
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="@color/status_disconnected" />
        </LinearLayout>

        <!-- 검색 가능 상태 카드 (핵심: 다른 폰이 스캔했을 때 보이려면 반드시 필요) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_bg"
            android:padding="16dp"
            android:layout_marginBottom="14dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="블루투스 검색 가능 상태"
                android:textSize="12sp"
                android:textColor="@color/text_secondary"
                android:paddingBottom="6dp" />

            <TextView
                android:id="@+id/tv_discoverable_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="○ 검색 불가 — 다른 폰에서 이 기기를 찾을 수 없음"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/status_disconnected"
                android:paddingBottom="12dp" />

            <Button
                android:id="@+id/btn_request_discoverable"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="검색 허용 (300초)"
                android:textColor="@color/white"
                android:backgroundTint="@color/accent_blue" />
        </LinearLayout>

        <!-- 블루투스 이름 설정 카드 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_bg"
            android:padding="16dp"
            android:layout_marginBottom="14dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="블루투스 기기 이름 (다른 폰에 표시되는 이름)"
                android:textSize="12sp"
                android:textColor="@color/text_secondary"
                android:paddingBottom="6dp" />

            <TextView
                android:id="@+id/tv_current_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="저장된 이름: Car Navigation"
                android:textSize="14sp"
                android:textColor="@color/text_primary"
                android:paddingBottom="4dp" />

            <TextView
                android:id="@+id/tv_actual_bt_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="실제 BT 이름: 읽는 중..."
                android:textSize="13sp"
                android:textColor="@color/text_secondary"
                android:paddingBottom="10dp" />

            <EditText
                android:id="@+id/et_device_name"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:hint="예: Car Navigation"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_dim"
                android:backgroundTint="@color/accent_blue"
                android:padding="8dp"
                android:inputType="text"
                android:maxLines="1"
                android:layout_marginBottom="10dp" />

            <Button
                android:id="@+id/btn_save_name"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:text="이름 저장 및 적용"
                android:textColor="@color/white"
                android:backgroundTint="@color/accent_blue" />
        </LinearLayout>

        <!-- 연결된 기기 카드 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_bg"
            android:padding="16dp"
            android:layout_marginBottom="14dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="연결된 스마트폰"
                android:textSize="12sp"
                android:textColor="@color/text_secondary"
                android:paddingBottom="6dp" />

            <TextView
                android:id="@+id/tv_connected_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="연결된 기기 없음"
                android:textSize="15sp"
                android:textColor="@color/text_primary"
                android:lineSpacingMultiplier="1.5" />
        </LinearLayout>

        <!-- 서버 시작/중지 버튼 -->
        <Button
            android:id="@+id/btn_toggle_service"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="서버 시작"
            android:textSize="17sp"
            android:textColor="@color/white"
            android:backgroundTint="@color/accent_green"
            android:layout_marginBottom="20dp" />

        <!-- 사용 안내 카드 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_bg"
            android:padding="16dp"
            android:layout_marginBottom="24dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="사용 방법"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/text_secondary"
                android:paddingBottom="8dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="1. 원하는 블루투스 기기 이름 입력 후 저장\n   (다른 폰에 이 이름으로 표시됩니다)\n\n2. [서버 시작] 버튼을 누르세요\n\n3. 다른 스마트폰에서 블루투스 설정 열기\n   → 이 기기(공기계) 검색 및 페어링\n\n4. 연결되면 다른 폰이 이 기기를\n   &#34;핸즈프리 / 차량&#34; 기기로 인식합니다\n\n5. HFP 프로파일로 인식되어 통화 연동,\n   주행 모드 등이 자동 활성화됩니다"
                android:textSize="13sp"
                android:textColor="@color/text_secondary"
                android:lineSpacingMultiplier="1.5" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
