<?xml version="1.0" encoding="utf-8"?>
<!--
    Adaptive icon foreground: 108 × 108 dp
    Safe zone (always visible): x 21–87, y 21–87

    Layout
    ──────
    • Car silhouette (side view)  →  lower 70 % of canvas
    • Record-button badge         →  upper-right, overlaps windshield like a dashcam
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- ════════════════  CAR  ════════════════ -->

    <!-- Roof / cabin silhouette (trapezoid with curved shoulders) -->
    <path
        android:fillColor="#CFD8DC"
        android:pathData="M26,46 Q28,31 38,27 L70,27 Q80,31 82,46 Z"/>

    <!-- Main body (rounded rectangle chassis) -->
    <path
        android:fillColor="#ECEFF1"
        android:pathData="M22,46 L86,46
                          Q92,46 92,52 L92,68
                          Q92,74 86,74 L22,74
                          Q16,74 16,68 L16,52
                          Q16,46 22,46 Z"/>

    <!-- Rear window -->
    <path
        android:fillColor="#4DD0E1"
        android:pathData="M28,46 Q29,35 35,29 L44,29 L44,46 Z"/>

    <!-- Middle window -->
    <path
        android:fillColor="#4DD0E1"
        android:pathData="M46,46 L46,28 L64,28 L64,46 Z"/>

    <!-- Front windshield -->
    <path
        android:fillColor="#4DD0E1"
        android:pathData="M66,46 Q67,35 73,29 L77,29 Q82,33 82,46 Z"/>

    <!-- B-pillar (rear–middle divider) -->
    <path
        android:fillColor="#90A4AE"
        android:pathData="M44,46 L44,29 L46,28 L46,46 Z"/>

    <!-- C-pillar (middle–front divider) -->
    <path
        android:fillColor="#90A4AE"
        android:pathData="M64,46 L64,28 L66,29 L66,46 Z"/>

    <!-- Headlight (front) -->
    <path
        android:fillColor="#FFF9C4"
        android:pathData="M86,53 L92,55 L92,63 L86,63
                          Q84,63 84,58 Q84,53 86,53 Z"/>

    <!-- Taillight (rear) -->
    <path
        android:fillColor="#EF9A9A"
        android:pathData="M16,55 L22,55 L22,63 L16,63 Z"/>

    <!-- Door line (subtle detail) -->
    <path
        android:fillColor="#B0BEC5"
        android:strokeColor="#B0BEC5"
        android:strokeWidth="1"
        android:pathData="M54,46 L54,74"/>

    <!-- ── Front wheel ── -->
    <path android:fillColor="#263238"
        android:pathData="M70,74 m-13,0 a13,13 0,1,0 26,0 a13,13 0,1,0 -26,0"/>
    <path android:fillColor="#546E7A"
        android:pathData="M70,74 m-7,0 a7,7 0,1,0 14,0 a7,7 0,1,0 -14,0"/>
    <path android:fillColor="#90A4AE"
        android:pathData="M70,74 m-3,0 a3,3 0,1,0 6,0 a3,3 0,1,0 -6,0"/>
    <path android:fillColor="#263238"
        android:pathData="M70,74 m-1,0 a1,1 0,1,0 2,0 a1,1 0,1,0 -2,0"/>

    <!-- ── Rear wheel ── -->
    <path android:fillColor="#263238"
        android:pathData="M36,74 m-13,0 a13,13 0,1,0 26,0 a13,13 0,1,0 -26,0"/>
    <path android:fillColor="#546E7A"
        android:pathData="M36,74 m-7,0 a7,7 0,1,0 14,0 a7,7 0,1,0 -14,0"/>
    <path android:fillColor="#90A4AE"
        android:pathData="M36,74 m-3,0 a3,3 0,1,0 6,0 a3,3 0,1,0 -6,0"/>
    <path android:fillColor="#263238"
        android:pathData="M36,74 m-1,0 a1,1 0,1,0 2,0 a1,1 0,1,0 -2,0"/>

    <!-- ════════════════  DASHCAM / RECORD BADGE  ════════════════ -->
    <!--
        Positioned in the upper-right, overlapping the windshield top —
        visually reads as a dashcam unit mounted on the glass.
        Center (80, 26).
    -->

    <!-- Dark backing (ensures contrast over the light car roof) -->
    <path
        android:fillColor="#0D1B2A"
        android:pathData="M80,26 m-17,0 a17,17 0,1,0 34,0 a17,17 0,1,0 -34,0"/>

    <!-- White ring -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M80,26 m-13,0 a13,13 0,1,0 26,0 a13,13 0,1,0 -26,0"/>

    <!-- Red record fill -->
    <path
        android:fillColor="#FF3B30"
        android:pathData="M80,26 m-9,0 a9,9 0,1,0 18,0 a9,9 0,1,0 -18,0"/>

    <!-- Tiny white glare dot (makes the lens look glass-like) -->
    <path
        android:fillColor="#FFFFFF"
        android:fillAlpha="0.55"
        android:pathData="M76,22 m-2.5,0 a2.5,2.5 0,1,0 5,0 a2.5,2.5 0,1,0 -5,0"/>

</vector>
