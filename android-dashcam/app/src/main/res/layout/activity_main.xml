<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <!--
        GL renders camera + overlay to this surface every frame.
        EGL_RECORDABLE_ANDROID is set on our EGL config so the same
        GL context also renders to the MediaCodec encoder surface.
    -->
    <SurfaceView
        android:id="@+id/surfaceView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!--
        GPS/address/datetime/speed are burned directly into the GL composite
        (see OverlayVideoRecorder.bakeOverlay) and rendered onto this SurfaceView
        every frame, so the native views below stay hidden — otherwise the same
        info would be shown twice (GL overlay + these views) on the live preview.
        They are kept (not removed) so MainActivity's text-update calls keep working.
    -->

    <!-- ── Top-left: GPS coordinates + address ── -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_margin="12dp"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvLocation"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="GPS 대기중..."
            android:textColor="#FFFFFF"
            android:textSize="28sp"
            android:textStyle="bold"
            android:fontFamily="monospace"
            android:lineSpacingMultiplier="1.2"
            android:shadowColor="#CC000000"
            android:shadowDx="1"
            android:shadowDy="1"
            android:shadowRadius="4" />

        <TextView
            android:id="@+id/tvAddress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:maxWidth="260dp"
            android:maxLines="2"
            android:ellipsize="end"
            android:text=""
            android:textColor="#FFFFFF"
            android:textSize="28sp"
            android:textStyle="bold"
            android:shadowColor="#CC000000"
            android:shadowDx="1"
            android:shadowDy="1"
            android:shadowRadius="4" />

    </LinearLayout>

    <!-- ── Top-right: Date/Time ── -->
    <TextView
        android:id="@+id/tvDateTime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_margin="12dp"
        android:text=""
        android:textColor="#FFFFFF"
        android:textSize="28sp"
        android:textStyle="bold"
        android:fontFamily="monospace"
        android:shadowColor="#CC000000"
        android:shadowDx="1"
        android:shadowDy="1"
        android:shadowRadius="4"
        android:visibility="gone" />

    <!-- ── Bottom-left: Speed ── -->
    <TextView
        android:id="@+id/tvSpeed"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="16dp"
        android:layout_marginBottom="16dp"
        android:text="0\nkm/h"
        android:textColor="#FFFFFF"
        android:textSize="28sp"
        android:textStyle="bold"
        android:fontFamily="monospace"
        android:gravity="center"
        android:lineSpacingMultiplier="0.9"
        android:shadowColor="#CC000000"
        android:shadowDx="1"
        android:shadowDy="1"
        android:shadowRadius="4"
        android:visibility="gone" />

    <!-- ── Bottom-right: REC indicator ── -->
    <TextView
        android:id="@+id/tvRecording"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="20dp"
        android:text="● REC"
        android:textColor="#FF3B30"
        android:textSize="16sp"
        android:textStyle="bold"
        android:visibility="gone"
        android:shadowColor="#CC000000"
        android:shadowDx="1"
        android:shadowDy="1"
        android:shadowRadius="4" />

    <!-- ── Center-bottom: Record + Exit buttons ── -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="24dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageButton
            android:id="@+id/btnRecord"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:background="@drawable/btn_record_bg"
            android:src="@drawable/ic_record"
            android:scaleType="center"
            android:padding="18dp"
            android:elevation="4dp"
            android:contentDescription="@string/record_button_desc" />

        <ImageButton
            android:id="@+id/btnExit"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_marginStart="24dp"
            android:background="@drawable/btn_record_bg"
            android:src="@drawable/ic_exit"
            android:scaleType="center"
            android:padding="14dp"
            android:elevation="4dp"
            android:contentDescription="@string/exit_button_desc" />

    </LinearLayout>

</FrameLayout>
