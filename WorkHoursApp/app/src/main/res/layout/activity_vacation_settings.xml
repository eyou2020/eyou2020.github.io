<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root_vacation_settings"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F5F5">

    <!-- 현재 설정 표시 -->
    <TextView
        android:id="@+id/tv_current_vacation_settings"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="13sp"
        android:gravity="center"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:paddingLeft="14dp"
        android:paddingRight="14dp"
        android:background="#FFFFFF"
        android:text="저장된 휴가 설정이 없습니다." />

    <View android:layout_width="match_parent" android:layout_height="1dp"
        android:background="#EEEEEE"/>

    <!-- 휴가 기간 카드 (시작 + 종료 통합) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#FFFFFF"
        android:paddingLeft="14dp"
        android:paddingRight="14dp"
        android:paddingTop="10dp"
        android:paddingBottom="4dp"
        android:layout_marginTop="8dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="휴가 기간"
            android:textSize="14sp"
            android:textColor="#212121"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <!-- 시작 연월 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="40dp"
                android:layout_height="wrap_content"
                android:text="시작"
                android:textSize="13sp"
                android:textColor="#616161" />

            <NumberPicker
                android:id="@+id/np_start_year"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="년"
                android:textSize="13sp"
                android:layout_marginLeft="2dp"
                android:layout_marginRight="8dp" />

            <NumberPicker
                android:id="@+id/np_start_month"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="월"
                android:textSize="13sp"
                android:layout_marginLeft="2dp" />
        </LinearLayout>

        <View android:layout_width="match_parent" android:layout_height="1dp"
            android:background="#EEEEEE" android:layout_marginTop="2dp" android:layout_marginBottom="2dp"/>

        <!-- 종료 연월 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="40dp"
                android:layout_height="wrap_content"
                android:text="종료"
                android:textSize="13sp"
                android:textColor="#616161" />

            <NumberPicker
                android:id="@+id/np_end_year"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="년"
                android:textSize="13sp"
                android:layout_marginLeft="2dp"
                android:layout_marginRight="8dp" />

            <NumberPicker
                android:id="@+id/np_end_month"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="월"
                android:textSize="13sp"
                android:layout_marginLeft="2dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- 1년 휴가 일수 카드 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#FFFFFF"
        android:paddingLeft="14dp"
        android:paddingRight="14dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:gravity="center_vertical"
        android:layout_marginTop="8dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="1년 휴가 일수"
            android:textSize="14sp"
            android:textColor="#212121"
            android:textStyle="bold" />

        <NumberPicker
            android:id="@+id/np_annual_days"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="일"
            android:textSize="14sp"
            android:layout_marginLeft="6dp" />
    </LinearLayout>

    <!-- 차감 안내 -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="※ 연차 1일 차감 · 반차 0.5일 차감 · 공가 차감 없음"
        android:textSize="11sp"
        android:textColor="#9E9E9E"
        android:gravity="center"
        android:paddingTop="6dp"
        android:paddingBottom="6dp" />

    <!-- 저장 버튼 -->
    <Button
        android:id="@+id/btn_vacation_save"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginLeft="16dp"
        android:layout_marginRight="16dp"
        android:layout_marginTop="8dp"
        android:text="저  장"
        android:textSize="16sp"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:background="@drawable/bg_save_button" />

</LinearLayout>
